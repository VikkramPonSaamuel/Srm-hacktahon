# ==============================================================================
# Application Configuration
# ==============================================================================
PROJECT_NAME="Synthetic Business Transactions — Autonomous Transaction Monitoring & Recovery"
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api/v1
VERSION=0.1.0

# ==============================================================================
# Logging Configuration
# Levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Format: json or console
# ==============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=console

# ==============================================================================
# Authentication & Role-Based Access Control (RBAC)
# Roles:
#   - admin: full access (playbook creation/updates, demo seeding, approvals)
#   - operator: operational access (playbook executions, incident retries/escalations, investigations)
#   - viewer: read-only access to journeys, incidents, metrics, dashboards
# Set AUTH_ENABLED=True to enforce API key validation via 'X-API-Key' or 'Authorization: Bearer <key>'
# ==============================================================================
AUTH_ENABLED=False
ADMIN_API_KEY=srm-admin-key-secret
OPERATOR_API_KEY=srm-operator-key-secret
VIEWER_API_KEY=srm-viewer-key-secret

# ==============================================================================
# AI & LLM Investigation Configuration
# Provider choices: 'none', 'mock', 'openai', 'anthropic', 'gemini'
# If provider is 'none' or 'mock', the engine uses deterministic rule-based analysis.
# ==============================================================================
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL_NAME=deterministic_fallback
LLM_API_BASE=
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=10.0

# ==============================================================================
# Rate Limiting Configuration for Sensitive Operations
# Protects recovery triggers, playbook executions, escalations, investigations, and demo seeding
# ==============================================================================
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# ==============================================================================
# CORS Configuration
# JSON-encoded array of allowed origin URLs or comma-separated strings
# ==============================================================================
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# ==============================================================================
# PostgreSQL Database Configuration
# ==============================================================================
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=srm_user
POSTGRES_PASSWORD=srm_secure_password
POSTGRES_DB=srm_db

# Optional direct connection string override (e.g., for SQLite in local dev or cloud database)
# DATABASE_URL=sqlite:///./srm_dev.db
# DATABASE_URL=postgresql+psycopg2://srm_user:srm_secure_password@localhost:5432/srm_db

DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
